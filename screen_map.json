          "id": "appReturnBtn",
          "notes": "Key transition — enters the legacy Classic app where transcripts live"
        },
        "enroll": { "role": "link", "label": "Enroll", "id": "adminRegisterBtn" },
        "staff": { "role": "link", "label": "Staff", "id": "asap-admin-nav-ul" },
        "attendance": { "role": "link", "label": "Attendance" },
        "calendar": { "role": "link", "label": "Calendar" },
        "communication_center": { "role": "link", "label": "Communication Center", "id": "ComunicationsCenter" },
        "checkin_dashboard": { "role": "link", "label": "Check-in: Dashboard", "id": "checkInDashboard" },
        "checkin_kiosk": { "role": "link", "label": "Check-in: Kiosk", "id": "checkInKiosk" },
        "checkin_facilities": { "role": "link", "label": "Check-in: Facilities", "id": "checkInFacility" },
        "registrar_mode": { "role": "link", "label": "Registrar Mode", "id": "registrarMode" },
        "point_of_sale": { "role": "link", "label": "Point Of Sale" },
        "account_info": { "role": "link", "label": "Account Info" },
        "course_groups": { "role": "link", "label": "Course Groups", "id": "GroupCourses" },
        "customer_groups": { "role": "link", "label": "Customer Groups", "id": "GroupCustomers" },
        "discounts": { "role": "link", "label": "Discounts", "id": "Discounts" },
        "features": { "role": "link", "label": "Features" },
        "financials": { "role": "link", "label": "Financials", "id": "lnkSetupFinancials" },
        "general_settings": { "role": "link", "label": "General Settings" },
        "online_registration": { "role": "link", "label": "Online Registration" },
        "registration_forms": { "role": "link", "label": "Registration Forms", "id": "RegistrationForms" },
        "sites": { "role": "link", "label": "Sites" },
        "terms": { "role": "link", "label": "Terms" },
        "user_access": { "role": "link", "label": "User Access" },
        "waivers": { "role": "link", "label": "Waivers" },
        "toggle_calendar": { "role": "button", "label": "Toggle calendar" },
        "terms_of_use": { "role": "link", "label": "Terms Of Use", "id": "asap-admin-interface" }
      },
      "transitions": [
        {
          "action": "click",
          "element": "return_to_classic",
          "then": "classic_home",
          "notes": "Enters ASAP Classic legacy app"
        }
      ]
    },

    "classic_home": {
      "name": "Classic - Home",
      "url_pattern": "app.asapconnected.com/default.aspx",
      "title": "Home",
      "notes": "Landing page of ASAP Classic (legacy app). Contains the full classic nav bar — Find, Create, Tools, Configure, View Reports — plus a global Quick Search and time period selector. This is the hub for all transcript and student work.",
      "elements": {
        "school_name": {
          "role": "link",
          "label": "Hayward Adult School (4347)",
          "id": "litSchoolName"
        },
        "switch_org": {
          "role": "link",
          "label": "switch",
          "id": "lbSwitchOrgs"
        },
        "time_period": {
          "role": "combobox",
          "label": "Time Period",
          "id": "ddlTimePeriod",
          "name_attr": "ctl00$ddlTimePeriod",
          "options": [
            "All Active", "All Time Periods", "FallSemNonHSD2026",
            "Summer Session II 2026", "SummerNonHSD2026", "Summer Session I 2026",
            "ESL Spring 25-26", "FY 25-26"
          ],
          "notes": "Global time period filter — affects search results and reports"
        },
        "my_settings": { "role": "link", "label": "My Settings", "id": "MySettingsPrimary" },
        "logout": { "role": "link", "label": "Logout", "id": "LogoutMaster" },
        "home": { "role": "link", "label": "Home", "id": "link0Home" },
        "quick_search_input": {
          "role": "textbox",
          "label": "Quick Search",
          "id": "txtQuickSearch",
          "notes": "Global search box — searches Students, Classes, Invoices, or Staff depending on ddlQuickSearch"
        },
        "quick_search_type": {
          "role": "combobox",
          "label": "Search Type",
          "id": "ddlQuickSearch",
          "options": ["Students", "Classes", "Invoices", "Staff"]
        },
        "quick_search_btn": {
          "role": "button",
          "label": "",
          "id": "btnQuickSearch"
        },
        "quick_enroll": { "role": "link", "label": "Quick Enroll", "id": "HyperLink18" },
        "find": { "role": "link", "label": "Find", "id": "accNav", "notes": "Top-level nav — expands find submenu" },
        "create": { "role": "link", "label": "Create", "id": "ctl16_HyperLink8" },
        "tools": { "role": "link", "label": "Tools", "id": "ctl18_HyperLink300" },
        "configure": { "role": "link", "label": "Configure", "id": "ctl22_HyperLink12" },
        "view_reports": { "role": "link", "label": "View Reports", "id": "ctl24_HyperLink10" },
        "switch_view": { "role": "link", "label": "Switch View", "id": "ctl26_hlSwitch" },
        "get_help": { "role": "link", "label": "Get Help", "id": "ctl28_HyperLink19" },
        "asap4": { "role": "link", "label": "ASAP 4", "id": "HyperLinkASAPBeta", "notes": "Returns to new ASAP 4 (admin.asapconnected.com)" },
        "quick_links": { "role": "link", "label": "Quick Links", "id": "HyperLink22" },
        "last_report": { "role": "link", "label": "Last Report", "id": "lnkQN03" },
        "last_page": { "role": "link", "label": "Last Page", "id": "lnkQN04" }
      },
      "transitions": [
        {
          "action": "fill+click",
          "element": "quick_search_input",
          "notes": "Search for a student by name or ID",
          "then": "student_search_results"
        },
        {
          "action": "click",
          "element": "find",
          "then": "?",
          "notes": "Expands Find submenu — map submenu options"
        }
      ]
    },

    "student_search_results": {
      "name": "Classic - Student Search Results",
      "url_pattern": "app.asapconnected.com/Students.aspx",
      "title": "Students",
      "notes": "Repeating list of matching students. Each row contains student PII (full name, email, phone, DOB, address, student ID) plus a set of action links. The inspector suppresses all data-row text except known action labels to protect PII.",
      "pii_warning": "This screen contains student PII in every row. Never paste raw page content — always use the inspector which suppresses data rows automatically.",
      "columns": [
        "Full Name", "Email", "Phone", "Date of Birth", "Address", "Student ID"
      ],
      "row_actions": [
        { "role": "link", "label": "Quick Enroll" },
        { "role": "link", "label": "Email" },
        { "role": "link", "label": "View Schedule" },
        { "role": "link", "label": "View Details" },
        { "role": "link", "label": "View Account" },
        { "role": "link", "label": "Edit" }
      ],
      "page_controls": [
        { "role": "button", "label": "Advanced Search", "notes": "Opens advanced filter options" },
        { "role": "button", "label": "Add New", "notes": "Creates a new student record" },
        { "notes": "Sortable columns — clicking a column header re-sorts the list" }
      ],
      "transitions": [
        {
          "action": "click",
          "element": "View Details",
          "then": "?",
          "notes": "Opens the individual student detail page — map next"
        },
        {
          "action": "click",
          "element": "Edit",
          "then": "?",
          "notes": "Opens the student edit form — map next"
        },
        {
          "action": "click",
          "element": "Quick Enroll",
          "then": "?",
          "notes": "Opens quick enroll flow for that student"
        }
      ]
    }
  },

