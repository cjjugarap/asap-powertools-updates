        "staff": { "role": "link", "label": "Staff", "id": "asap-admin-nav-ul" },
        "attendance": { "role": "link", "label": "Attendance" },
        "calendar": { "role": "link", "label": "Calendar" },
        "communication_center": { "role": "link", "label": "Communication Center", "id": "ComunicationsCenter" },
        "checkin_dashboard": { "role": "link", "label": "Check-in: Dashboard", "id": "checkInDashboard" },
        "checkin_kiosk": { "role": "link", "label": "Check-in: Kiosk", "id": "checkInKiosk" },
        "checkin_facilities": { "role": "link", "label": "Check-in: Facilities", "id": "checkInFacility" },
        "registrar_mode": { "role": "link", "label": "Registrar Mode", "id": "registrarMode" },
        "point_of_sale": { "role": "link", "label": "Point Of Sale" },
        "account_info": { "role": "link", "label": "Account Info" },
        "course_groups": { "role": "link", "label": "Course Groups", "id": "GroupCourses" },
        "customer_groups": { "role": "link", "label": "Customer Groups", "id": "GroupCustomers" },
        "discounts": { "role": "link", "label": "Discounts", "id": "Discounts" },
        "features": { "role": "link", "label": "Features" },
        "financials": { "role": "link", "label": "Financials", "id": "lnkSetupFinancials" },
        "general_settings": { "role": "link", "label": "General Settings" },
        "online_registration": { "role": "link", "label": "Online Registration" },
        "registration_forms": { "role": "link", "label": "Registration Forms", "id": "RegistrationForms" },
        "sites": { "role": "link", "label": "Sites" },
        "terms": { "role": "link", "label": "Terms" },
        "user_access": { "role": "link", "label": "User Access" },
        "waivers": { "role": "link", "label": "Waivers" },
        "toggle_calendar": { "role": "button", "label": "Toggle calendar" },
        "terms_of_use": { "role": "link", "label": "Terms Of Use", "id": "asap-admin-interface" }
      },
      "transitions": [
        {
          "action": "click",
          "element": "return_to_classic",
          "then": "classic_home",
          "notes": "Enters ASAP Classic legacy app"
        }
      ]
    },

