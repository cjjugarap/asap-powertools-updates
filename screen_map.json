{
  "screens": {
    "login_org": {
      "name": "Login — Organization ID",
      "url_pattern": "admin.asapconnected.com/account/login",
      "title": "Login",
      "notes": "Entry point. User enters their numeric Org ID and clicks Continue.",
      "elements": {
        "org": {
          "role": "spinbutton",
          "label": "Organization ID #",
          "id": "org",
          "name_attr": "org"
        },
        "continue": {
          "role": "button",
          "label": "Continue",
          "id": "continue"
        },
        "need_help": {
          "role": "link",
          "label": "Need help?"
        }
      },
      "transitions": [
        {
          "action": "click",
          "element": "continue",
          "then": "login_account_select",
          "notes": "Proceeds after Org ID is filled in"
        }
      ]
    },

    "login_account_select": {
      "name": "Login — Select Account",
      "url_pattern": "id.vancoplatform.com/*/login/account-select",
      "title": "Select an Account",
      "notes": "SSO account picker via Vanco identity platform. The account tile is an unlabelled button (likely an avatar/image component). 'more' expands account options. User clicks their account tile to proceed.",
      "elements": {
        "account_tile": {
          "role": "button",
          "label": "(unlabelled)",
          "id": null,
          "notes": "The saved account card — label not readable by inspector, rendered as image/custom component"
        },
        "more": {
          "role": "button",
          "label": "more",
          "id": "toggle-account-0",
          "notes": "Expands additional options for the saved account"
        },
        "add_another_account": {
          "role": "link",
          "label": "Add another account"
        },
        "privacy_policy": {
          "role": "link",
          "label": "Privacy Policy"
        }
      },
      "transitions": [
        {
          "action": "click",
          "element": "account_tile",
          "then": "login_password",
          "notes": "Selecting the account loads the password entry screen"
        }
      ]
    },

    "login_password": {
      "name": "Login — Enter Password",
      "url_pattern": "id.vancoplatform.com/*/login/pwd",
      "title": "Enter Password",
      "notes": "Vanco SSO password step. Email is pre-filled from the selected account (login_hint in URL). Password field is sensitive and always redacted.",
      "elements": {
        "password": {
          "role": "textbox",
          "label": "Password",
          "id": "password",
          "sensitive": true
        },
        "toggle_password_visibility": {
          "role": "button",
          "label": "toggle password visibility",
          "notes": "Show/hide password toggle — no ID"
        },
        "next": {
          "role": "button",
          "label": "Next",
          "id": "login-btn",
          "notes": "Submits password and proceeds"
        },
        "switch_account": {
          "role": "link",
          "label": "Switch account",
          "notes": "Goes back to account select"
        },
        "forgot_password": {
          "role": "link",
          "label": "Forgot password?",
          "id": "password-helper-text"
        },
        "privacy_policy": {
          "role": "link",
          "label": "Privacy Policy"
        }
      },
      "transitions": [
        {
          "action": "click",
          "element": "next",
          "then": "login_stay_signed_in",
          "notes": "Submits password — leads to Stay signed in prompt"
        },
        {
          "action": "click",
          "element": "switch_account",
          "then": "login_account_select"
        }
      ]
    },

    "login_stay_signed_in": {
      "name": "Login - Stay Signed In",
      "url_pattern": "id.vancoplatform.com/*/login/kmsi",
      "title": "Stay signed in?",
      "notes": "Optional prompt after password. User can check 'Don't ask me again' before clicking Yes. Clicking Yes completes the SSO flow and lands on the main app.",
      "elements": {
        "dont_ask_again": {
          "role": "checkbox",
          "label": "Don't ask me again",
          "notes": "If checked, this screen is skipped on future logins"
        },
        "yes": {
          "role": "button",
          "label": "Yes",
          "id": "setup-btn",
          "notes": "Confirms and completes login"
        },
        "privacy_policy": {
          "role": "link",
          "label": "Privacy Policy"
        }
      },
      "transitions": [
        {
          "action": "click",
          "element": "yes",
          "then": "dashboard",
          "notes": "Completes SSO and lands on the main dashboard"
        }
      ]
    },

