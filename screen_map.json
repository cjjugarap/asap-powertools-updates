      "notes": "Main hub after login. Contains the full nav menu, global search, quick links, and a calendar widget. 'Return to ASAP Classic' is the gateway to the legacy app where transcripts and student detail live.",
      "elements": {
        "logo": {
          "role": "link",
          "label": "ASAP",
          "id": "asap-admin-header-logo"
        },
        "search": {
          "role": "textbox",
