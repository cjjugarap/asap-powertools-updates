          "id": "litSchoolName"
        },
        "switch_org": {
          "role": "link",
          "label": "switch",
          "id": "lbSwitchOrgs"
        },
        "time_period": {
          "role": "combobox",
          "label": "Time Period",
          "id": "ddlTimePeriod",
          "name_attr": "ctl00$ddlTimePeriod",
          "options": [
            "All Active", "All Time Periods", "FallSemNonHSD2026",
            "Summer Session II 2026", "SummerNonHSD2026", "Summer Session I 2026",
            "ESL Spring 25-26", "FY 25-26"
          ],
          "notes": "Global time period filter — affects search results and reports"
        },
        "my_settings": { "role": "link", "label": "My Settings", "id": "MySettingsPrimary" },
        "logout": { "role": "link", "label": "Logout", "id": "LogoutMaster" },
        "home": { "role": "link", "label": "Home", "id": "link0Home" },
        "quick_search_input": {
          "role": "textbox",
          "label": "Quick Search",
          "id": "txtQuickSearch",
          "notes": "Global search box — searches Students, Classes, Invoices, or Staff depending on ddlQuickSearch"
        },
        "quick_search_type": {
          "role": "combobox",
          "label": "Search Type",
          "id": "ddlQuickSearch",
          "options": ["Students", "Classes", "Invoices", "Staff"]
        },
        "quick_search_btn": {
          "role": "button",
          "label": "",
          "id": "btnQuickSearch"
        },
        "quick_enroll": { "role": "link", "label": "Quick Enroll", "id": "HyperLink18" },
        "find": { "role": "link", "label": "Find", "id": "accNav", "notes": "Top-level nav — expands find submenu" },
        "create": { "role": "link", "label": "Create", "id": "ctl16_HyperLink8" },
        "tools": { "role": "link", "label": "Tools", "id": "ctl18_HyperLink300" },
        "configure": { "role": "link", "label": "Configure", "id": "ctl22_HyperLink12" },
        "view_reports": { "role": "link", "label": "View Reports", "id": "ctl24_HyperLink10" },
        "switch_view": { "role": "link", "label": "Switch View", "id": "ctl26_hlSwitch" },
        "get_help": { "role": "link", "label": "Get Help", "id": "ctl28_HyperLink19" },
        "asap4": { "role": "link", "label": "ASAP 4", "id": "HyperLinkASAPBeta", "notes": "Returns to new ASAP 4 (admin.asapconnected.com)" },
        "quick_links": { "role": "link", "label": "Quick Links", "id": "HyperLink22" },
        "last_report": { "role": "link", "label": "Last Report", "id": "lnkQN03" },
        "last_page": { "role": "link", "label": "Last Page", "id": "lnkQN04" }
      },
      "transitions": [
        {
          "action": "fill+click",
          "element": "quick_search_input",
          "notes": "Search for a student by name or ID",
          "then": "student_search_results"
        },
        {
          "action": "click",
          "element": "find",
          "then": "?",
          "notes": "Expands Find submenu — map submenu options"
        }
      ]
    },

    "student_search_results": {
      "name": "Classic - Student Search Results",
      "url_pattern": "app.asapconnected.com/Students.aspx?s=*",
      "title": "Students",
      "notes": "Repeating list of matching students. Each row contains student PII (full name, email, phone, DOB, address, student ID) plus a set of action links. The inspector suppresses all data-row text except known action labels to protect PII.",
      "pii_warning": "This screen contains student PII in every row. Never paste raw page content — always use the inspector which suppresses data rows automatically.",
      "columns": [
        "Full Name", "Email", "Phone", "Date of Birth", "Address", "Student ID"
      ],
      "row_actions": [
        { "role": "link", "label": "Quick Enroll", "id_suffix": "aReg", "id_pattern": "ctl00_ContentPlaceHolder1_rptStudents_ctrlN_aReg" },
        { "role": "link", "label": "Email", "notes": "No stable id found" },
        { "role": "link", "label": "View Schedule", "id_suffix": "btnViewSchedule", "id_pattern": "ctl00_ContentPlaceHolder1_rptStudents_ctrlN_btnViewSchedule" },
        { "role": "link", "label": "View Details", "id_suffix": "lbtnViewDetails", "id_pattern": "ctl00_ContentPlaceHolder1_rptStudents_ctrlN_lbtnViewDetails" },
        { "role": "link", "label": "View Account", "id_suffix": "lbViewAccount", "id_pattern": "ctl00_ContentPlaceHolder1_rptStudents_ctrlN_lbViewAccount" },
        { "role": "link", "label": "Edit", "id_suffix": "lbEdit", "id_pattern": "ctl00_ContentPlaceHolder1_rptStudents_ctrlN_lbEdit" }
      ],
      "repeater_pattern": "rptStudents_ctrlN — N is 0-based row index. id_suffix is stable across rows and data sets.",
      "page_controls": [
        { "role": "button", "label": "Advanced Search", "notes": "Opens advanced filter options" },
        { "role": "button", "label": "Add New", "notes": "Creates a new student record" },
        { "notes": "Sortable columns — clicking a column header re-sorts the list" }
      ],
      "transitions": [
        {
          "action": "click",
          "element": "View Details",
          "then": "student_detail",
          "notes": "Opens the individual student detail page"
        },
        {
          "action": "click",
          "element": "Edit",
          "then": "?",
          "notes": "Opens the student edit form — map next"
        },
        {
          "action": "click",
          "element": "Quick Enroll",
          "then": "?",
          "notes": "Opens quick enroll flow for that student"
        }
      ]
    },

    "student_detail": {
      "name": "Classic - Student Detail",
      "url_pattern": "app.asapconnected.com/StudentDetail.aspx?id=*",
      "title": "Student Detail",
      "notes": "Full record for a single student. Contains multiple data tables (enrollments, transcripts, attendance, tests, invoices, etc). Key screen for transcript automation — the Print button triggers the transcript report.",
      "pii_warning": "Page contains student PII in data rows. Inspector suppresses data rows automatically.",
      "table_columns": {
        "enrollments": ["Code", "Course Name", "Instructor", "Enrollment Date", "Activity", "EventID", "Status", "Start Date", "endDate", "Auto Re-Enroll", "Invoice ID", "Invoice Date", "Amount"],
        "transcript": ["Year", "Term", "Class", "Teacher", "Grade", "Credits", "School Name", "Class Name", "Class Number", "Grade Level", "Grade Earned", "Credit Earned", "Course Group", "Subject"],
        "schedule": ["Schedule", "# of Lessons Scheduled", "Unscheduled Lessons", "Lesson Completed", "Duration", "Invoice"],
        "attendance": ["Service", "Date", "Time", "Staff", "Notes"],
        "tests": ["Test Name", "Student TestID", "Section", "Result", "Score", "Level", "Site", "Facility"]
      },
      "tabs": {
        "credits": {
          "label": "Credits",
          "notes": "Contains the Certificates & Programs section. Inspector cannot capture this tab's elements because the RadPageView panel remains display:none in the DOM even when active — IDs below were identified manually.",
          "elements": {
            "select_program": {
              "role": "combobox",
              "label": "Select Program",
              "id": "ContentPlaceHolder1_ddlPrograms",
              "id_suffix": "ddlPrograms",
              "name_attr": "ctl00$ContentPlaceHolder1$ddlPrograms",
              "section": "Certificates & Programs",
              "notes": "Native <select> (not Kendo). Selecting a program reveals the credit detail fields below. For transcript printing, choose 'High School Diploma'.",
              "known_options": ["High School Diploma"]
            },
            "diploma_date": {
              "role": "textbox",
              "label": "Diploma Date",
              "notes": "Date field revealed after selecting a program. Should be the LATER of the two dates. If Graduation Date > Diploma Date, the values were entered in the wrong fields — swap them before printing.",
              "id_unknown": true
            },
            "graduation_date": {
              "role": "textbox",
              "label": "Graduation Date",
              "notes": "Date field revealed after selecting a program. Should be the EARLIER of the two dates.",
              "id_unknown": true
            }
          },
          "data_correction_rule": {
            "condition": "graduation_date > diploma_date",
            "action": "swap diploma_date and graduation_date",
            "reason": "Dates were originally entered in the wrong fields. Diploma Date must be >= Graduation Date for the transcript to print correctly."
          }
        }
      },
      "elements": {
        "view_schedule": {
          "role": "link",
          "label": "View Schedule",
          "id": "ContentPlaceHolder1_btnViewSchedule",
          "id_suffix": "btnViewSchedule"
        },
        "print_report": {
          "role": "button",
          "label": "View and Print student's detail report",
          "id": "ContentPlaceHolder1_btnPrint",
          "id_suffix": "btnPrint",
          "name_attr": "ctl00$ContentPlaceHolder1$btnPrint",
          "notes": "KEY — triggers the transcript/detail report popup"
        },
        "back_to_students": {
          "role": "link",
          "label": "Back to Students",
          "id": "ContentPlaceHolder1_hlBackStudentsList",
          "id_suffix": "hlBackStudentsList"
        },
        "edit": {
          "role": "link",
          "label": "edit",
          "id": "ContentPlaceHolder1_btnCustTypeEdit",
          "id_suffix": "btnCustTypeEdit"
        },
        "remove_group": {
          "role": "link",
          "label": "Remove",
          "id": "ContentPlaceHolder1_rptGroups_lnkDeleteCustomerGroup_0",
          "notes": "Removes a customer group from the student"
        },
            "save_credit_program": {
              "role": "button",
              "label": "(unlabelled — Save)",
              "id": "ContentPlaceHolder1_btnsavecreditprogramdetails",
              "id_suffix": "btnsavecreditprogramdetails",
              "notes": "Saves the selected credit program and date fields. Must be clicked after swap_dates before navigating to the Transcripts tab."
            }
          "role": "tab",
          "label": "Transcripts",
          "notes": "Tab on student detail page. Click after Credits tab work to access View Transcript Report link. Tab ID not captured by inspector (RadPageView hidden panel) — click by label.",
          "id_unknown": true
        },
        "view_transcript_report": {
          "role": "link",
          "label": "View Transcript Report",
          "id": "ContentPlaceHolder1_aTranscriptReport",
          "id_suffix": "aTranscriptReport",
          "section": "Transcripts tab",
          "notes": "Opens CustomerTranscript.aspx in a new popup window."
        }
      },
      "transitions": [
        {
          "action": "click",
          "element": "print_report",
          "then": "transcript_report_popup",
          "notes": "Opens the transcript/detail report in a new popup window"
        },
        {
          "action": "click",
          "element": "back_to_students",
          "then": "student_search_results"
        }
      ]
    }
  },

    "transcript_report_popup": {
      "name": "Classic - Transcript Report (Popup)",
      "url_pattern": "app.asapconnected.com/Reports/CustomerTranscript.aspx?StudentID=*",
      "title": "ASAP Connected - Transactions By Customer",
      "notes": "Transcript report configuration popup opened from Student Detail → Transcripts tab → View Transcript Report. User configures display options via checkboxes, then clicks Filter or Print. Opens in a separate browser window — extension must be used from within the popup itself.",
      "elements": {
        "hide_gpa":                  { "role": "checkbox", "label": "Hide GPA",                                       "id": "HideGPA",                        "default": false },
        "display_cal_grant_gpa":     { "role": "checkbox", "label": "Display Cal Grant GPA",                         "id": "DisplayCalGPA",                  "default": false },
        "display_attendance_hours":  { "role": "checkbox", "label": "Display Attendance Hours",                      "id": "DisplayAttendanceHours",         "default": false },
        "display_test_score":        { "role": "checkbox", "label": "Display Test Score",                            "id": "DisplayTestScore",               "default": false },
        "landscape":                 { "role": "checkbox", "label": "Landscape",                                     "id": "LandscapeTranscript",            "default": true  },
        "group_by_year_school":      { "role": "checkbox", "label": "Group by Year and School Name",                 "id": "Grouping",                       "default": false },
        "display_requirement_group": { "role": "checkbox", "label": "Display Requirement Group",                     "id": "GroupingRequirement",            "default": false },
        "show_all_enrollments":      { "role": "checkbox", "label": "Show all enrollments regardless of status",     "id": "DisplayAllRegardlessOfStatus",   "default": false },
        "display_enrollment_status": { "role": "checkbox", "label": "Display Enrollment Status (Portrait Only)",     "id": "DisplayEnrStatus",               "default": false },
        "report_card":               { "role": "checkbox", "label": "Report Card",                                   "id": "ReportCard",                     "default": false, "notes": "Mutually exclusive with other options; reveals a time period selector" },
        "display_diploma_date":      { "role": "checkbox", "label": "Display Diploma Date",                         "id": "DisplayDiplomaDate",             "default": true  },
        "display_certificate_date":  { "role": "checkbox", "label": "Display Certificate Date",                     "id": "DisplayCertificateDate",         "default": false },
        "display_graduation_date":   { "role": "checkbox", "label": "Display Graduation Date",                      "id": "DisplayGraduationDate",          "default": true  },
        "show_dropped_classes":      { "role": "checkbox", "label": "Show dropped classes",                         "id": "ShowDClasses",                   "default": false },
        "display_grade_level":       { "role": "checkbox", "label": "Display Grade Level",                          "id": "DisplayGradeLevel",              "default": false },
        "cmb_program": {
          "role": "combobox",
          "label": "(Kendo — Program selector)",
          "id": "cmbProgram",
          "id_suffix": "cmbProgram",
          "type": "select_kendo",
          "notes": "Kendo dropdown inside the transcript popup. Select the program (e.g. High School Diploma) before checking print options."
        },
        "btn_filter": {
          "role": "button",
          "label": "(unlabelled — Filter)",
          "id": "btnFilter",
          "notes": "Applies selected options and refreshes the transcript preview"
        },
        "btn_print": {
          "role": "button",
          "label": "(unlabelled — Print / Export to Print)",
          "id": "btnPrint",
          "notes": "Sends transcript to the browser print dialog. This is the 'Export to Print' button referenced in the HSD process."
        },
        "upload_second_logo": {
          "role": "link",
          "label": "Upload second logo"
        },
        "privacy_policy": {
          "role": "link",
          "label": "Privacy Policy"
        }
      },
      "transitions": [
        {
          "action": "click",
          "element": "btn_filter",
          "then": "transcript_report_popup",
          "notes": "Refreshes the same popup with updated display options applied"
        },
        {
          "action": "click",
          "element": "btn_print",
          "then": "browser_print_dialog",
          "notes": "Opens browser print dialog — outside app scope"
        }
      ]
    }
  },

  "processes": {
    "print_hsd_transcript": {
      "name": "Print High School Diploma Transcript",
      "description": "Search for a student, verify and correct diploma/graduation dates on the Credits tab, then print the HSD transcript with the correct display options.",
      "steps": [
        {
          "step": 1,
          "screen": "classic_home",
          "action": "fill",
          "element": "quick_search_input",
          "value": "<student name or ID>",
          "notes": "Set quick_search_type to 'Students' first if not already selected"
        },
        {
          "step": 2,
          "screen": "classic_home",
          "action": "click",
          "element": "quick_search_btn",
          "then": "student_search_results"
        },
        {
          "step": 3,
          "screen": "student_search_results",
          "action": "click",
          "element": "View Details",
          "notes": "Click View Details for the correct student row",
          "then": "student_detail"
        },
        {
          "step": 4,
          "screen": "student_detail",
          "tab": "credits",
          "action": "select",
          "element": "select_program",
          "value": "High School Diploma",
          "notes": "Reveals Diploma Date and Graduation Date fields"
        },
        {
          "step": 5,
          "screen": "student_detail",
          "tab": "credits",
          "action": "verify_and_correct",
          "rule": "data_correction_rule",
          "notes": "Read both date fields. If graduation_date > diploma_date, swap the values. Diploma Date must be the later date."
        },
        {
          "step": "5b",
          "screen": "student_detail",
          "tab": "credits",
          "action": "click",
          "element": "save_credit_program",
          "notes": "Save the credit program details before switching tabs. btnsavecreditprogramdetails."
        },
        {
          "step": 6,
          "screen": "student_detail",
          "action": "click",
          "element": "transcripts_tab",
