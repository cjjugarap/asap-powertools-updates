{
  "manifest_version": 3,
  "name": "ASAP Page Inspector",
  "version": "1.0",
  "description": "Maps any ASAP Connected screen — labels, IDs, structure. No PII captured.",
  "permissions": ["scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Inspect this ASAP screen"
  }
}
